# backend/.env.example
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:efar-backend-2026@db.arorhvtvepwimqwhrzps.supabase.co:5432/postgres            # Supabase PostgreSQL connection string: postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_URL=https://arorhvtvepwimqwhrzps.supabase.co/             # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY= sb_publishable_0MaAqdcnSf_FqISNNRQMsQ_3BxEuSH9       # Public anon key from Supabase dashboard → Project Settings → API

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=    # Cloud name from Cloudinary dashboard
CLOUDINARY_API_KEY=       # API key from Cloudinary dashboard
CLOUDINARY_API_SECRET=    # API secret from Cloudinary dashboard

# ── AI / OCR ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=           # Google AI Studio API key (Gemini 1.5 Pro)

# ── Xero ──────────────────────────────────────────────────────────────────────
XERO_CLIENT_ID=           # OAuth2 client ID from Xero developer portal
XERO_CLIENT_SECRET=       # OAuth2 client secret from Xero developer portal
XERO_REDIRECT_URI=        # OAuth2 callback URL e.g. http://localhost:3000/api/xero/callback
XERO_ENCRYPTION_KEY=      # 32-byte hex key for AES-256-GCM encryption of stored Xero tokens

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=               # Production JWT signing secret - use a long random string
DEV_JWT_SECRET=dev-secret-efar  # Shared dev secret - ALL teammates must use this exact value

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
