# backend/.env.example
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=            # Supabase PostgreSQL connection string: postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_URL=             # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=       # Public anon key from Supabase dashboard → Project Settings → API

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=    # Cloud name from Cloudinary dashboard
CLOUDINARY_API_KEY=       # API key from Cloudinary dashboard
CLOUDINARY_API_SECRET=    # API secret from Cloudinary dashboard

# ── AI / OCR ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=           # Google AI Studio API key (Gemini 1.5 Pro)

# ── Geocoding (Live Fleet Tracker) ───────────────────────────────────────────
GOOGLE_GEOCODING_API_KEY= # Server-side key with the Geocoding API enabled (GCP console) -
                          # separate from the browser-restricted VITE_GOOGLE_MAPS_API_KEY

# ── Xero ──────────────────────────────────────────────────────────────────────
# SIMULATION MODE (default): leave XERO_SIMULATION unset or =true. The AP → Xero
# flow (connect, callback, approve→sync, retry) works end-to-end with generated
# identifiers, so no real Xero account is needed to run or demo the app.
# To hit the real Xero API: set XERO_SIMULATION=false AND fill in the four values
# below (register a free app at https://developer.xero.com → My Apps → New app).
XERO_SIMULATION=true      # true = simulate Xero (no live credentials needed); false = real API
XERO_CLIENT_ID=           # OAuth2 client ID from Xero developer portal (only needed for /connect + real mode)
XERO_CLIENT_SECRET=       # OAuth2 client secret from Xero developer portal (real mode only)
XERO_REDIRECT_URI=        # OAuth2 callback URL e.g. http://localhost:3000/api/xero/callback
XERO_ENCRYPTION_KEY=      # 64-char (32-byte) hex key for AES-256-GCM encryption of stored Xero tokens (real mode only)
                          # generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
XERO_SCOPES=              # optional override; default includes accounting.invoices, accounting.contacts, and accounting.settings.read
XERO_SALES_ACCOUNT_CODE=     # optional: Xero account code for AR (ACCREC) invoice line items, e.g. 200
XERO_PURCHASE_ACCOUNT_CODE=  # optional: Xero account code for AP (ACCPAY) bill line items, e.g. 400

# ── AP automatic email intake ───────────────────────────────────────────────
# Set up your mail provider's inbound-parse/forwarding rule to POST each PDF
# attachment as multipart field `attachments` to /api/vendor-invoices/inbound-email.
# Include a stable provider message id in `message_id` and this secret in the
# X-AP-Inbound-Secret header. The address is displayed to AP staff; the secret never is.
AP_INBOUND_EMAIL_ADDRESS=     # e.g. vendor-invoices@efar.com.sg
AP_INBOUND_EMAIL_SECRET=      # long random shared secret for the inbound mail provider
AP_INBOUND_UPLOADED_BY=       # optional AP Specialist user id; otherwise oldest AP specialist is used

# ── Gmail AP intake ──────────────────────────────────────────────────────────
# Google Cloud OAuth web-client values. Connect the inbox from Vendor Invoices,
# label vendor emails "EFAR AP Invoices", and the server imports them automatically.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GOOGLE_GMAIL_INBOX=            # display-only expected inbox, e.g. efar.vendor.invoices@gmail.com
GMAIL_INTAKE_POLL_MS=300000    # optional; defaults to five minutes (minimum one minute)

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=               # Production JWT signing secret - use a long random string
DEV_JWT_SECRET=dev-secret-efar-2026  # Shared dev secret - ALL teammates must use this exact value (matches the pre-signed tokens in design/jasper/api-documentation.md)

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
